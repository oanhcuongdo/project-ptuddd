# Thêm các biến môi trường tại đây
API_BASE_URL=https://api.example.com/v1
API_KEY=your_api_key_here

# #12 — máy chủ trung gian tóm tắt AI. Key Gemini nằm ở server, KHÔNG đặt trong app.
# Dùng "mock" để xem trước giao diện khi chưa có máy chủ.
AI_SUMMARY_ENDPOINT=https://api.example.com/v1/summarize

# Supabase — kho dữ liệu chung của nhóm (PostgreSQL + Realtime + Storage).
# Truyền vào lúc build/run, ví dụ:
#   flutter run --dart-define=SUPABASE_URL=... --dart-define=SUPABASE_ANON_KEY=...
# CHỈ dùng anon key (public). TUYỆT ĐỐI KHÔNG đặt service_role key trong app.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
