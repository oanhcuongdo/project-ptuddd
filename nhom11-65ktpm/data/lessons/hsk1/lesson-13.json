  "grammarPoints": [
    {
      "id": "gp-modal-before-verb",
      "pattern": "会 / 能 / 可以 + động từ",
      "explanationVi": "Động từ năng nguyện đứng trước động từ chính; 会 thường nói kỹ năng đã học, 能 nói khả năng hoặc điều kiện, 可以 nói sự cho phép.",
      "examples": [
        "我会说汉语。",
        "你今天能来吗？",
        "我可以坐这儿吗？"
      ]
    },
    {
      "id": "gp-xiang-verb",
      "pattern": "想 + động từ",
      "explanationVi": "想 đứng trước động từ để diễn tả mong muốn làm việc gì.",
      "examples": [
        "我想喝茶。",
        "我想去中国。"
      ]
    },
    {
      "id": "gp-juede-clause",
      "pattern": "觉得 + nhận xét",
      "explanationVi": "觉得 đứng trước một mệnh đề hoặc nhận xét để nêu cảm nhận, ý kiến.",
      "examples": [
        "我觉得这本书很好。",
        "我觉得汉语很有意思。"
      ]
    }
  ],
  "aiScenario": {
    "aiRole": "bạn cùng lớp đang tìm bạn tham gia câu lạc bộ",
    "learnerRole": "sinh viên mới muốn tìm hiểu câu lạc bộ tiếng Trung",
    "situation": "Hai bạn hỏi về sở thích và khả năng tham gia một buổi sinh hoạt.",
    "openingLine": "你喜欢学习汉语吗？你今天能来吗？"
  }
}
