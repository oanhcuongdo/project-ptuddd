  "grammarPoints": [
    {
      "id": "gp-zuo-transport",
      "pattern": "坐 + phương tiện + 去 / 来 + địa điểm",
      "explanationVi": "坐 đứng trước tên phương tiện; 去 diễn tả đi đến nơi khác, còn 来 hướng về phía người nói.",
      "examples": [
        "我坐火车去北京。",
        "他坐飞机来中国。"
      ]
    },
    {
      "id": "gp-distance-li",
      "pattern": "Địa điểm + 离 + nơi + 近 / 远",
      "explanationVi": "离 nối hai địa điểm khi nói khoảng cách gần hay xa.",
      "examples": [
        "学校离我家很近。",
        "机场离这儿很远。"
      ]
    },
    {
      "id": "gp-time-dao",
      "pattern": "Phương tiện + 几点 + 到？",
      "explanationVi": "Đặt 到 sau thời gian để hỏi phương tiện đến nơi lúc nào.",
      "examples": [
        "火车几点到？",
        "飞机上午十点到。"
      ]
    }
  ],
  "aiScenario": {
