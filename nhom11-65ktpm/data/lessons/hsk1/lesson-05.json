  "grammarPoints": [
    {
      "id": "gp-jiao-name",
      "pattern": "Chủ ngữ + 叫 + tên",
      "explanationVi": "叫 dùng để giới thiệu tên của mình hoặc hỏi tên người khác.",
      "examples": [
        "我叫小明。",
        "你叫什么名字？"
      ]
    },
    {
      "id": "gp-wh-word-shui",
      "pattern": "谁 + 是 + ...？",
      "explanationVi": "谁 là từ để hỏi người; câu hỏi có từ để hỏi không cần thêm 吗.",
      "examples": [
        "谁是你的老师？",
        "他是谁？"
      ]
    },
    {
      "id": "gp-de-possession",
      "pattern": "Đại từ + 的 + danh từ",
      "explanationVi": "的 đứng giữa người sở hữu và danh từ, ví dụ 我的书 là sách của tôi.",
      "examples": [
        "这是我的书。",
        "他是我的同学。"
      ]
    }
