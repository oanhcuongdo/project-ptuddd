  "grammarPoints": [
    {
      "id": "gp-time-before-subject",
      "pattern": "Thời gian + Chủ ngữ + Động từ",
      "explanationVi": "Từ chỉ thời gian thường đứng trước chủ ngữ hoặc sau chủ ngữ để nêu thời điểm xảy ra hành động.",
      "examples": [
        "今天我去学校。",
        "我今天去学校。"
      ]
    },
    {
      "id": "gp-ask-time",
      "pattern": "现在 + 几点？",
      "explanationVi": "Dùng 几点 để hỏi giờ; khi trả lời, đặt số đứng trước 点.",
      "examples": [
        "现在几点？",
        "现在八点。"
      ]
    },
    {
      "id": "gp-duration-minutes",
      "pattern": "Số + 分钟",
      "explanationVi": "Đặt số trước 分钟 để nói một khoảng thời gian tính bằng phút.",
      "examples": [
        "我等你十分钟。",
        "我学习二十分钟。"
      ]
    }
  ],
