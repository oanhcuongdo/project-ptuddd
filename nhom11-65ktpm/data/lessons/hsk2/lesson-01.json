      "explanationVi": "和 nối hai danh từ hoặc đại từ với nghĩa là 'và'.",
      "examples": [
        "他和妻子一起去商店。",
        "爸爸和妈妈在家。"
      ]
    },
    {
      "id": "gp-together-action",
      "pattern": "Chủ ngữ + 和 + người + 一起 + động từ",
      "explanationVi": "一起 đứng trước động từ để nói hai hay nhiều người cùng làm việc gì.",
      "examples": [
        "我和姐姐一起吃饭。",
        "他和妻子一起去商店。"
      ]
    },
