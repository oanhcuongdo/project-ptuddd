  "grammarPoints": [
    {
      "id": "gp-yijing-le",
      "pattern": "已经 + động từ + 了",
      "explanationVi": "已经 nhấn mạnh việc đã xảy ra hoặc hoàn tất; 了 có thể đặt ở cuối câu.",
      "examples": [
        "我已经做完作业了。",
        "他已经回家了。"
      ]
    },
    {
      "id": "gp-de-adverb",
      "pattern": "Tính từ + 地 + động từ",
      "explanationVi": "地 nối từ miêu tả cách thức với động từ, thường dịch là 'một cách...'.",
      "examples": [
        "她认真地学习汉语。",
        "他高兴地说话。"
      ]
    },
    {
      "id": "gp-daily-practice",
      "pattern": "每天 + động từ",
      "explanationVi": "每天 đứng trước động từ để nói về thói quen hằng ngày.",
      "examples": [
        "我们每天练习说汉语。",
        "我每天复习生词。"
      ]
    }
