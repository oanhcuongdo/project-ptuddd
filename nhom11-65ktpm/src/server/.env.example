PROJECT_NAME="ChaiLish API"
API_V1_STR="/api"
ENVIRONMENT="development"

# PostgreSQL 16 (khi chạy bằng docker compose, host là "db")
DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/chailish_db"

# JWT
SECRET_KEY="chailish_super_secret_jwt_key_change_in_production"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Dịch vụ bên ngoài (chỉ lưu trên server, không đưa vào app)
ANTHROPIC_API_KEY="your_anthropic_api_key_here"
AZURE_SPEECH_KEY="your_azure_speech_key_here"
AZURE_SPEECH_REGION="southeastasia"

# Quên mật khẩu: OTP gửi qua SMTP (để trống SMTP_HOST thì OTP chỉ ghi ra log)
OTP_EXPIRE_MINUTES=10
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="ChaiLish <no-reply@chailish.app>"

# Chống dò mật khẩu
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_SECONDS=900
AUTH_REQUESTS_PER_MINUTE=20

# Docker Compose
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=chailish_db
POSTGRES_PORT=5432
SERVER_NAME=localhost
HTTP_PORT=80
HTTPS_PORT=443

# Trợ lý ôn bài AI: AI_PROVIDER=anthropic (mặc định) hoặc openai
AI_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-opus-5-5   # đổi sang claude-haiku-5-5 để giảm chi phí
OPENAI_API_KEY=""
OPENAI_MODEL=gpt-5-mini
OPENAI_BASE_URL=""                # dịch vụ tương thích OpenAI (để trống = OpenAI)
OPENAI_REASONING_EFFORT_ENABLED=true
AI_DAILY_MESSAGE_LIMIT=40
AI_DAILY_CONVERSATION_LIMIT=10
AI_MAX_TURNS=8
AI_MAX_MESSAGE_CHARS=120
