  "grammarPoints": [
    {
      "id": "gp-age",
      "pattern": "S + (今年) + số + 岁",
      "explanationVi": "Nói tuổi không cần 是: 我二十岁, không nói 我是二十岁 trong câu thông thường.",
      "examples": [
        "我今年二十岁。",
        "你多大？"
      ]
    },
    {
      "id": "gp-measure-ge",
      "pattern": "Số + 个 + Danh từ",
      "explanationVi": "Giữa số và danh từ phải có lượng từ, 个 là lượng từ chung.",
      "examples": [
        "三个学生",
        "一个老师"
      ]
    },
    {
      "id": "gp-liang",
      "pattern": "两 + lượng từ",
      "explanationVi": "Đếm 'hai cái' dùng 两, không dùng 二: 两个人.",
      "examples": [
        "两个人",
        "两口人"
      ]
    }
  ],
  "aiScenario": {
    "aiRole": "nhân viên đăng ký câu lạc bộ tiếng Trung, thân thiện",
    "learnerRole": "sinh viên muốn đăng ký tham gia câu lạc bộ",
    "situation": "Nhân viên hỏi thông tin để điền phiếu: tên, tuổi, nhà có mấy người.",
    "openingLine": "你好！请问你叫什么名字？你多大？"
  }
