      "example": {
        "hanzi": "三口人",
        "pinyin": "sān kǒu rén",
        "meaningVi": "ba người"
      }
    },
    {
      "id": "ren",
      "hanzi": "人",
      "pinyin": "rén",
      "hanViet": "nhân",
      "meaningVi": "người",
      "example": {
        "hanzi": "他是中国人。",
        "pinyin": "Tā shì Zhōngguó rén.",
        "meaningVi": "Anh ấy là người Trung Quốc."
