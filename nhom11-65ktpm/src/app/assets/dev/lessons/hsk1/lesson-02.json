  "grammarPoints": [
    {
      "id": "gp-you",
      "pattern": "S + 有 + O",
      "explanationVi": "有 diễn tả sở hữu; phủ định dùng 没有, không dùng 不有.",
      "examples": [
        "我有一个妹妹。",
        "我没有哥哥。"
      ]
    },
    {
      "id": "gp-ji-kou",
      "pattern": "你家有几口人？",
      "explanationVi": "几 hỏi số lượng nhỏ (dưới 10), đi kèm lượng từ.",
      "examples": [
        "你家有几口人？",
        "我家有三口人。"
      ]
    },
    {
      "id": "gp-de",
      "pattern": "Đại từ + (的) + người thân",
      "explanationVi": "Với người thân có thể bỏ 的: 我妈妈 = 我的妈妈.",
      "examples": [
        "我妈妈",
        "我的老师"
      ]
    }
  ],
  "aiScenario": {
    "aiRole": "bạn cùng phòng ký túc xá người Bắc Kinh",
