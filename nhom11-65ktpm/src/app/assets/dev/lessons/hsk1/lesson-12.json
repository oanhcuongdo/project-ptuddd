  "grammarPoints": [
    {
      "id": "gp-body-hen-adjective",
      "pattern": "Bộ phận cơ thể + 很 + tính từ",
      "explanationVi": "Đặt tính từ sau chủ ngữ để miêu tả tình trạng cơ thể.",
      "examples": [
        "我的手很疼。",
        "她的眼睛很大。"
      ]
    },
    {
      "id": "gp-qu-le",
      "pattern": "Động từ + 了",
      "explanationVi": "了 ở cuối câu có thể đánh dấu tình trạng mới phát sinh hoặc sự việc đã xảy ra.",
      "examples": [
        "我今天生病了。",
        "他吃药了。"
      ]
    },
    {
      "id": "gp-qing-verb",
      "pattern": "请 + động từ",
      "explanationVi": "请 đứng trước động từ để đưa ra lời nhờ hoặc yêu cầu lịch sự.",
      "examples": [
        "请洗手。",
        "请休息。"
      ]
    }
