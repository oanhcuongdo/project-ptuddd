rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getTrip(tripId) {
      return get(/databases/$(database)/documents/trips/$(tripId)).data;
    }

    function isTripMember(tripId) {
      return isSignedIn() && request.auth.uid in getTrip(tripId).memberIds;
    }

    function isTripHost(tripId) {
      return isSignedIn() && getTrip(tripId).hostId == request.auth.uid;
    }

    // 1. Hồ sơ người dùng
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId);
      allow delete: if false;
    }

    // 2. Tra cứu mã mời QR
    match /invite_codes/{code} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create, update, delete: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid;
    }

    // 3. Thư viện mẫu Checklist (Chỉ đọc)
    match /checklist_templates/{templateId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // 4. Chuyến đi & Các Subcollection
    match /trips/{tripId} {
      allow read: if isTripMember(tripId);
      allow create: if isSignedIn()
        && request.resource.data.hostId == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds;
      allow update: if isTripHost(tripId)
        || (isSignedIn() && request.auth.uid in request.resource.data.memberIds);
      allow delete: if isTripHost(tripId);

      // 4.1 Thành viên
      match /members/{memberId} {
        allow read: if isTripMember(tripId);
        allow create: if isOwner(memberId) || isTripHost(tripId);
        allow update: if isTripHost(tripId) || isOwner(memberId);
        allow delete: if isTripHost(tripId) || isOwner(memberId);
      }

      // 4.2 Module 1: Checklist
      match /checklists/{itemId} {
        allow read: if isTripMember(tripId)
          && (resource.data.scope == 'group' || resource.data.ownerId == request.auth.uid);
        allow create, update, delete: if isTripMember(tripId);
      }

      // 4.3 Module 2: Cấu hình quỹ MoMo
      match /momo_fund_config/{configId} {
        allow read: if isTripMember(tripId);
        allow create, update, delete: if isTripHost(tripId);
      }

      // 4.4 Module 2: Kế hoạch tích góp
      match /saving_plans/{memberId} {
        allow read: if isTripMember(tripId);
        allow create, update: if isTripHost(tripId) || isOwner(memberId);
        allow delete: if isTripHost(tripId);
      }

      // 4.5 Module 2: Giao dịch nạp quỹ & Biên lai MoMo
      match /deposit_records/{depositId} {
        allow read: if isTripMember(tripId);
        allow create: if isTripHost(tripId)
          || (isTripMember(tripId) && request.resource.data.memberId == request.auth.uid);
        allow update: if isTripHost(tripId)
          || (isTripMember(tripId)
              && resource.data.memberId == request.auth.uid
              && request.resource.data.status == 'PENDING');
        allow delete: if isTripHost(tripId);
      }

      // 4.6 Module 2: Chuỗi kỷ luật DailyYou Streak
      match /member_streaks/{memberId} {
        allow read: if isTripMember(tripId);
        allow create, update: if isTripHost(tripId) || isOwner(memberId);
        allow delete: if isTripHost(tripId);
      }

      // 4.7 Module 3: Lịch trình địa điểm & Check-in
      match /place_plans/{placeId} {
        allow read: if isTripMember(tripId);
        allow create: if isTripMember(tripId);
        allow update: if isTripHost(tripId)
          || (isTripMember(tripId)
              && ((!('approvalStatus' in request.resource.data) && !('approvalStatus' in resource.data))
                  || request.resource.data.approvalStatus == resource.data.get('approvalStatus', '')));
        allow delete: if isTripHost(tripId)
          || (isTripMember(tripId) && resource.data.get('createdBy', '') == request.auth.uid)
          || (isTripMember(tripId) && !('createdBy' in resource.data));
      }

      // 4.8 Module 4: Hũ ngân sách Cashew
      match /budget_envelopes/{envelopeId} {
        allow read: if isTripMember(tripId);
        allow create, delete: if isTripHost(tripId);
        allow update: if isTripMember(tripId);
      }

      // 4.9 Module 4: Ghi chép thực chi & OCR
      match /expenses/{expenseId} {
        allow read, create: if isTripMember(tripId);
        allow update, delete: if isTripHost(tripId)
          || (isTripMember(tripId) && resource.data.createdBy == request.auth.uid);
      }

      // 4.10 Module 4: Quyết toán công nợ
      match /settlements/{settlementId} {
        allow read: if isTripMember(tripId);
        allow create, delete: if isTripHost(tripId);
        allow update: if isTripHost(tripId)
          || (isTripMember(tripId)
              && (resource.data.fromUserId == request.auth.uid
                  || resource.data.toUserId == request.auth.uid));
      }
    }
  }
}
