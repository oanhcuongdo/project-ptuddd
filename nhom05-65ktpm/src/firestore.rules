rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function own(uid) { return signedIn() && request.auth.uid == uid; }
    function isMentor() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'mentor';
    }
    function groupMember(groupId) {
      return signedIn()
        && (request.auth.uid in get(/databases/$(database)/documents/study_groups/$(groupId)).data.memberUids
          || request.auth.uid == get(/databases/$(database)/documents/study_groups/$(groupId)).data.mentorUid);
    }

    match /users/{uid} {
      allow create: if own(uid)
        && request.resource.data.role == 'learner'
        && request.resource.data.groupId == null
        && request.resource.data.rate == null
        && request.resource.data.rateLevel == null
        && request.resource.data.attemptCount == 0
        && request.resource.data.keys().hasOnly([
          'displayName', 'email', 'role', 'rate', 'rateLevel', 'attemptCount', 'groupId', 'createdAt'
        ]);
      allow read: if own(uid) || isMentor();
      allow update: if own(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName'])
        || own(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'rate', 'rateLevel', 'attemptCount'
          ])
          && request.resource.data.rate is number
          && request.resource.data.rate >= 0
          && request.resource.data.rate <= 100
          && request.resource.data.rateLevel in ['Beginner', 'Elementary', 'Intermediate', 'Advanced']
          && request.resource.data.attemptCount >= 10
          && request.resource.data.attemptCount <= 20
        || isMentor()
          && resource.data.groupId == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['groupId'])
          && request.resource.data.groupId is string
          && getAfter(/databases/$(database)/documents/study_groups/$(request.resource.data.groupId)).data.mentorUid == request.auth.uid
          && uid in getAfter(/databases/$(database)/documents/study_groups/$(request.resource.data.groupId)).data.memberUids;
      allow delete: if false;

      match /private/{document} {
        allow read, write: if own(uid);
      }
    }

    match /study_groups/{groupId} {
      allow read: if isMentor() || groupMember(groupId);
      allow create: if isMentor()
        && request.resource.data.mentorUid == request.auth.uid
        && request.resource.data.level in ['Beginner', 'Elementary', 'Intermediate', 'Advanced']
        && request.resource.data.memberUids is list
        && request.resource.data.memberUids.size() >= 4
        && request.resource.data.memberUids.size() <= 6;
      allow update, delete: if false;
    }

    match /submissions/{submissionId} {
      allow read: if groupMember(resource.data.groupId) || isMentor();
      allow create: if signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'learner'
        && request.resource.data.learnerUid == request.auth.uid
        && groupMember(request.resource.data.groupId)
        && request.resource.data.keys().hasOnly(['groupId', 'learnerUid', 'title', 'createdAt']);
      allow update, delete: if false;

      match /comments/{commentId} {
        allow read: if groupMember(get(/databases/$(database)/documents/submissions/$(submissionId)).data.groupId);
        allow create: if signedIn()
          && groupMember(get(/databases/$(database)/documents/submissions/$(submissionId)).data.groupId)
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.keys().hasOnly(['authorUid', 'text', 'createdAt']);
        allow update, delete: if false;
      }
    }
  }
}
